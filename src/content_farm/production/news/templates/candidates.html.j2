<!doctype html>
{# HN 快報 candidate list: Leon ticks 1–2 stories on his phone; the page builds the
   one command to paste back. Self-contained (no external assets), autoescaped. #}
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HN 快報候選 {{ day }}</title>
<style>
:root { --bg:#f6f5f1; --card:#fff; --fg:#1c1d21; --muted:#6b6d75; --line:#e2e0da; --accent:#c8102e;
  --ok:#1b7f4b; --bad:#a33; --chip:#eef0f4; }
@media (prefers-color-scheme: dark) { :root { --bg:#141518; --card:#1e2024; --fg:#ecedef; --muted:#9a9ca4;
  --line:#2e3036; --accent:#ff5468; --ok:#4cc38a; --bad:#ff7b7b; --chip:#2a2d33; } }
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.5 -apple-system, "PingFang TC", "Noto Sans TC", sans-serif; }
header { padding:16px 16px 8px; }
h1 { font-size:20px; margin:0 0 4px; }
.meta { color:var(--muted); font-size:13px; }
.warn { margin:8px 16px; padding:10px 12px; border-radius:10px; background:#fff4e5; color:#7a4b00; font-size:14px; }
@media (prefers-color-scheme: dark) { .warn { background:#3a2c12; color:#ffcf8a; } }
main { padding:0 16px 140px; display:grid; gap:12px; max-width:760px; margin:0 auto; }
.card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px; display:grid;
  grid-template-columns: 34px 1fr; gap:4px 10px; }
.card.off { opacity:.55; }
.card input { width:26px; height:26px; margin:2px 0 0; accent-color:var(--accent); }
.rank { font-weight:800; color:var(--accent); font-size:14px; }
.title { font-weight:700; font-size:17px; line-height:1.35; overflow-wrap:anywhere; }
.row { grid-column:2; font-size:13px; color:var(--muted); overflow-wrap:anywhere; }
.chips { grid-column:2; display:flex; flex-wrap:wrap; gap:6px; }
.chip { background:var(--chip); border-radius:999px; padding:2px 9px; font-size:12px; }
.chip.tw { background:var(--accent); color:#fff; }
.read { grid-column:2; font-size:13px; }
.read.ok { color:var(--ok); } .read.bad { color:var(--bad); }
.desc { grid-column:2; font-size:14px; color:var(--fg); opacity:.85; }
a { color:inherit; }
.links { grid-column:2; display:flex; gap:14px; font-size:14px; flex-wrap:wrap; }
footer { position:fixed; left:0; right:0; bottom:0; background:var(--card); border-top:1px solid var(--line);
  padding:10px 16px calc(10px + env(safe-area-inset-bottom)); }
footer code { display:block; font-size:12px; overflow-wrap:anywhere; background:var(--chip); padding:8px; border-radius:8px; }
footer .bar { display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:6px; font-size:14px; }
button { font:inherit; font-weight:700; border:0; border-radius:10px; padding:9px 16px; background:var(--accent); color:#fff; }
button:disabled { opacity:.4; }
</style>
</head>
<body>
<header>
  <h1>{{ series_name }}・候選 {{ day }}</h1>
  <div class="meta">抓取 {{ fetched_at }}・{{ counts }}・近 {{ max_age|int }} 小時・依分數排序・挑 {{ pick_min }}–{{ pick_max }} 則</div>
</header>
{% for err in errors %}<div class="warn">來源失敗：{{ err }}</div>{% endfor %}
<div class="warn">規則：只列讀得到原文的題目可勾選；HN／Lobsters 留言只當線索。分數是排序參考，不是推薦。</div>
<main>
{% for r in ranked %}
  {% set c = r.candidate %}
  <label class="card{{ '' if r.read and r.read.ok else ' off' }}">
    <input type="checkbox" value="{{ loop.index }}" {{ '' if r.read and r.read.ok else 'disabled' }}>
    <div><span class="rank">#{{ loop.index }}・{{ '%.2f'|format(r.score) }}</span>
      <div class="title">{{ c.title }}</div></div>
    <div class="row">{{ c.domain }}・{{ r.age_hours }} 小時前{% for d in c.discussions %}・{{ {'hn':'HN','lobsters':'Lobsters','arxiv':'arXiv'}[d.site] }}{% if d.points is not none %} {{ d.points }} 分{% endif %}{% if d.comments is not none %} {{ d.comments }} 留言{% endif %}{% if d.rank %} 第{{ d.rank }}名{% endif %}{% endfor %}</div>
    <div class="chips">
      <span class="chip">熱度 {{ '%.2f'|format(r.popularity) }}</span>
      <span class="chip">台灣相關 {{ '%.2f'|format(r.relevance) }}</span>
      {% for why in r.reasons[:4] %}<span class="chip tw">{{ why }}</span>{% endfor %}
    </div>
    {% if r.read and r.read.ok %}
      <div class="read ok">✓ 已讀{{ '摘要' if r.read.kind == 'abstract' else '原文' }} {{ r.read.chars }} 字・{{ r.read.read_at[11:16] }}{% if r.read.published %}・發布 {{ r.read.published[:10] }}{% endif %}</div>
      {% if r.read.description %}<div class="desc">{{ r.read.description }}</div>{% endif %}
    {% elif r.read %}
      <div class="read bad">✗ 讀不到原文：{{ r.read.reason }}（不能做）</div>
    {% else %}
      <div class="read bad">✗ 尚未讀原文（不能做）</div>
    {% endif %}
    <div class="links"><a href="{{ c.url }}">原文 ↗</a>{% for d in c.discussions %}{% if d.url != c.url %}<a href="{{ d.url }}">{{ {'hn':'HN','lobsters':'Lobsters','arxiv':'arXiv'}[d.site] }} 討論 ↗</a>{% endif %}{% endfor %}</div>
  </label>
{% endfor %}
</main>
<footer>
  <div class="bar"><span id="count">還沒勾</span><button id="copy" disabled>複製指令</button></div>
  <code id="cmd">python scripts/produce.py news daily --date {{ day }} --pick …</code>
</footer>
<script>
(function () {
  const boxes = Array.from(document.querySelectorAll("input[type=checkbox]"));
  const cmd = document.getElementById("cmd"), count = document.getElementById("count"), copy = document.getElementById("copy");
  const base = "python scripts/produce.py news daily --date {{ day }} --pick ";
  function update() {
    const picked = boxes.filter(b => b.checked).map(b => b.value);
    count.textContent = picked.length ? "已勾 " + picked.length + " 則" : "還沒勾";
    count.style.color = picked.length > {{ pick_max }} ? "var(--bad)" : "";
    cmd.textContent = base + (picked.length ? picked.join(",") : "…");
    copy.disabled = picked.length === 0;
  }
  boxes.forEach(b => b.addEventListener("change", update));
  copy.addEventListener("click", () => {
    if (navigator.clipboard) navigator.clipboard.writeText(cmd.textContent).then(() => { copy.textContent = "已複製"; });
  });
  update();
})();
</script>
</body>
</html>
