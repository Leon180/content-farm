{# 晶片貓下班了 — 便利貼漫畫. Flat, outlined, hard shadows; the cat's face is the hook. #}
{% macro style() %}
body { background: var(--bg); color: var(--fg); font-family: "Noto Sans CJK TC", sans-serif; }
.dots { position: absolute; inset: 0; background-image: radial-gradient(rgba(20,20,20,.14) 2.4px, transparent 2.8px); background-size: 20px 20px; }
.punch { font-weight: 900; color: #fff; -webkit-text-stroke: 16px var(--fg); paint-order: stroke fill; text-shadow: 10px 10px 0 var(--fg); line-height: 1.08; }
.punch .pk { color: var(--accent); }
.sticker { position: absolute; background: var(--accent); color: #fff; border: 5px solid var(--fg); border-radius: 14px; font-weight: 900; box-shadow: 5px 5px 0 var(--fg); padding: 6px 22px; }
.bubble { position: absolute; background: #fff; border: 6px solid var(--fg); border-radius: 40px; font: 700 40px "Yuanti TC", sans-serif; padding: 16px 32px; }
.panel { position: absolute; background: #fff; border: 8px solid var(--fg); box-shadow: 10px 10px 0 var(--fg); overflow: hidden; }
.circle { position: absolute; border: 8px solid var(--accent); border-radius: 50%; transform: rotate(-8deg); }
{% endmacro %}

{% macro thumb(t, sil) %}
<div class="dots"></div>
<div style="position:absolute;left:0;top:0;bottom:0;width:470px;background:#fff;border-right:8px solid var(--fg)"></div>
{{ sil(40, 110, 400) }}
<div class="sticker" style="left:520px;top:54px;font-size:40px;transform:rotate(-4deg)">{{ t.tag }}</div>
<div class="punch" style="position:absolute;left:520px;top:160px;width:720px;font-size:{{ t.size|default(124) }}px">
  {% for line in t.lines %}<div>{{ line | replace(t.hl, '<span class="pk">' ~ t.hl ~ '</span>') | safe }}</div>{% endfor %}
</div>
{% if t.circle %}<div class="circle" style="{{ t.circle }}"></div>{% endif %}
{% endmacro %}

{% macro icon() %}
<div style="position:absolute;inset:0;background:var(--bg)"></div>
<div class="dots"></div>
<svg viewBox="0 0 800 800" style="position:absolute;inset:0">
  <g stroke="#141414" stroke-width="22" stroke-linejoin="round" stroke-linecap="round">
    <path d="M190 330 L210 140 L330 230 H470 L590 140 L610 330 C 640 520 540 640 400 640 C 260 640 160 520 190 330 Z" fill="#fff"/>
    <path d="M280 410 H350 M450 410 H520" fill="none"/>
    <path d="M370 500 Q400 520 430 500" fill="none"/>
  </g>
  <text x="590" y="250" font-family="Arial Rounded MT Bold" font-size="90" fill="#c2185b" stroke="#141414" stroke-width="6" paint-order="stroke">z</text>
  <text x="650" y="170" font-family="Arial Rounded MT Bold" font-size="66" fill="#c2185b" stroke="#141414" stroke-width="5" paint-order="stroke">z</text>
</svg>
{% endmacro %}

{% macro banner(sil) %}
<div class="dots"></div>
<div style="position:absolute;left:507px;top:509px;width:1546px;height:423px">
  {{ sil(20, 20, 260) }}
  <div class="punch" style="position:absolute;left:330px;top:40px;font-size:150px;white-space:nowrap">晶片貓<span class="pk">下班了</span></div>
  <div class="bubble" style="left:340px;top:250px">工程師冷笑話 Shorts ＋ 迷因考古長片</div>
  <div class="sticker" style="left:1250px;top:300px;font-size:34px;transform:rotate(5deg);white-space:nowrap">每天 12:30 一則</div>
</div>
{% endmacro %}

{% macro shorts(sil) %}
<div class="dots"></div>
<div class="sticker" style="left:70px;top:230px;font-size:44px;transform:rotate(-3deg)">冷笑話 #031</div>
<div class="panel" style="left:60px;top:340px;width:840px;height:520px">
  <div class="bubble" style="left:30px;top:24px;font-size:42px">需求只改一點點喔</div>
  <svg viewBox="0 0 240 344" style="position:absolute;left:520px;top:150px;width:250px;fill:#1a4fd8">
    <circle cx="120" cy="130" r="82"/>
    <ellipse cx="38" cy="150" rx="26" ry="62" transform="rotate(14 38 150)"/>
    <ellipse cx="202" cy="150" rx="26" ry="62" transform="rotate(-14 202 150)"/>
    <path d="M40 230 Q120 210 200 230 L210 344 H30 Z"/>
  </svg>
  <div style="position:absolute;left:240px;top:420px;font:700 30px 'Yuanti TC';color:var(--accent-2)">PM 狗（配角剪影）→</div>
</div>
<div class="panel" style="left:60px;top:900px;width:840px;height:520px;background:#fff">
  {{ sil(60, 120, 260) }}
  <div class="bubble" style="left:360px;top:60px;font-size:42px">一點點是<br>幾個點？</div>
  <div class="punch" style="position:absolute;left:360px;top:300px;font-size:96px"><span class="pk">好，冷。</span></div>
</div>
{% endmacro %}
