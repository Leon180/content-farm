CF_ANTHROPIC_API_KEY=sk-ant-...
CF_ELEVENLABS_API_KEY=...
CF_FISH_AUDIO_API_KEY=...
CF_TTS_PROVIDER=elevenlabs  # elevenlabs | fish_audio | macos_say
CF_FISH_AUDIO_REFERENCE_ID=  # Fish Audio voice reference ID (optional)
# macos_say: free local macOS `say` voice (needs ffmpeg). Development/testing only — never publish with it.
CF_MACOS_SAY_VOICE="Flo (Chinese (Taiwan))"  # list installed voices: say -v '?'
# CF_MACOS_SAY_RATE=200  # optional, words per minute (say -r); unset = voice default
CF_LLM_CHEAP_MODEL=claude-haiku-4-5
CF_LLM_EXPENSIVE_MODEL=claude-sonnet-4-6
CF_DEFAULT_LANGUAGE=zh-TW
CF_STOCK_PROVIDER=pexels  # pexels
CF_PEXELS_API_KEY=...
CF_FFMPEG_PATH=ffmpeg
CF_SUBTITLE_PROVIDER=whisper  # whisper (default, accurate timing) | estimation (no deps)
# Whisper settings (only used when CF_SUBTITLE_PROVIDER=whisper)
CF_WHISPER_MODEL_SIZE=base  # tiny | base | small | medium | large-v3
CF_WHISPER_LANGUAGE=zh
CF_WHISPER_DEVICE=cpu  # cpu | cuda | auto
CF_WHISPER_COMPUTE_TYPE=int8  # int8 | float16 | float32
CF_THUMBNAIL_PROVIDER=pillow  # pillow
CF_THUMBNAIL_FONT_PATH=  # Path to CJK font file (optional, auto-detects system fonts)
CF_YOUTUBE_PROVIDER=google  # google
CF_YOUTUBE_CLIENT_ID=...
CF_YOUTUBE_CLIENT_SECRET=...
CF_YOUTUBE_REFRESH_TOKEN=...
CF_TELEGRAM_BOT_TOKEN=  # Telegram bot token from @BotFather
CF_TELEGRAM_CHAT_ID=  # Your chat ID (get from @userinfobot)
CF_CACHE_BACKEND=file
CF_LOG_LEVEL=INFO
